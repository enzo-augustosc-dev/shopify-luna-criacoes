<section class="erro404">
  <h1 class="erro-numero">404</h1>
  <p class="erro-titulo">Página não encontrada</p>
  <p class="erro-texto">A página que você está procurando não existe ou foi movida.</p>

  <a href="/" class="erro-botao">Voltar para página inicial</a>
</section>

<style>
  section.erro404 {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-direction: column;

    margin-top: 200px;
  }

  .erro-numero {
    font-size: 300px;
    font-family: var(--bold);

    background: linear-gradient(90deg, var(--cor-verde-principal), var(--cor-verde-principal-hover));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .erro-titulo {
    font-size: 40px;
    font-family: var(--bold);
    margin-top: 20px;
  }

  .erro-texto {
    font-size: 20px;
    font-family: var(--light);
    margin-bottom: 20px;
  }

  .erro-botao {
    font-size: 16px;
    font-family: var(--bold);
    background-color: var(--cor-verde-principal-hover);

    padding: 20px;
    border-radius: 50px;
  }

</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Tracking de evento 404 (opcional)
    if (typeof gtag !== 'undefined') {
      gtag('event', 'page_view', {
        page_title: '404 - Página não encontrada',
        page_location: window.location.href
      });
    }
  });
</script>

{% schema %}
  {
    "name": "Página 404",
    "settings": [
      {
        "type": "header",
        "content": "Página de Erro 404"
      }, {
        "type": "paragraph",
        "content": "Esta seção exibe uma página de erro 404 com animações suaves e automáticas no número 404."
      }
    ]
  }
{% endschema %}
