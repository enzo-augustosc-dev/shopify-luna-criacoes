<div id="carrinho" class="cart">

{% form 'cart', cart %}

<h1>Carrinho</h1>

  {%if cart.empty?%}
    <h2 class="vazio">Seu carrinho está vazio! Adicione alguns produtos e volte aqui!</h2>

    <a href="/" class="botao">Voltar a comprar!</a>
  {% endif %}

  {% for item in cart.items %}

    <div class="produto-cart">
      <div class="info-produto">
        <img class="imagem-produto" src="{{ item | image_url}}">
        <h2>{{ item.title }}</h2>
      </div>

    <div class="controle-qtd">
      <button type="button" class="menos">-</button>

      <input
      class="qtd"
      name="updates[]"
      type="number"
      min="1"
      value="{{ item.quantity }}"
      readonly>

        <button type="button" class="mais">+</button>
    </div>

    <p class="preco">{{ item.price | money }}</p>
    <a class="remover" href="{{ item.url_to_remove }}">X</a>
    <hr>

  </div>

{% endfor %}

{% unless cart.empty? %}
  <div class="info-total">
    <p class="total">Total do Carrinho: {{ cart.total_price | money}}</p>

  <div class="butons">
    <button class="update" type="submit" name="update"> Atualizar Quantidade</button>

    <button class="checkout" type="submit" name="checkout">Comprar Agora!</button>
  </div>
  </div>
{% endunless %}

{% endform %}
</div>

<style>

  .cart {
    display: flex;
    align-items: center;
    text-align: center;
    justify-content: center;

    padding: 0 80px;
    width: 100%;
    margin-top: 120px;
  }

  h1{
    font-size: 40px;
    font-family: var(--bold);
    margin-bottom: 10px;
  }

 .vazio {
    font-size: 20px;
    font-family: var(--light);
    margin-bottom: 60px;
  }

  .botao {
    color: var(--cor-preto);
    font-size: 20px;
    font-family: var(--bold);
    background-color: var(--cor-verde-principal-hover);

    padding: 15px;
    border-radius: 50px;
  }

  .botao:hover {
    font-size: 18px;
    background-color: var(--cor-verde-principal);

    transition: ease-in-out 0.2s;
  }

  .produto-cart {
    display: grid;
    grid-template-columns: 1fr 80px 150px 60px;
    align-items: center;
    gap: 20px;
    margin-bottom: 20px;

    border-bottom: 1px solid var(--cor-gelo);
   padding-bottom: 20px;
}

  .info-produto {
    display: flex;
    align-items: center;
    gap: 15px;
  }

  .imagem-produto {
    width: 150px;
    height: 150px;
    object-fit: cover;
    border-radius: 40px;
  }

  .info-produto h2 {
    font-size: 30px;
    font-family: var(--bold);
    color: var(--cor-preto);
    margin: 0;
  }

  .controle-qtd {
    display: flex;
    align-items: center;
    justify-content: center;

    gap: 10px;
    font-family: var(--light);
  }

  .controle-qtd button {
    width: 40px;
    height: 40px;
    border-radius: 50%;

    padding: 10px;

    background-color: var(--cor-verde-principal);
    font-family: var(--light);
    color: white;
    font-size: 20px;
    cursor: pointer;
  }

  .controle-qtd input {
    width: 50px;
    text-align: center;
    font-size: 20px;
  }

  .qtd::-webkit-outer-spin-button,
  .qtd::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
    -moz-appearance: textfield;
  }

  .preco {
    font-size: 25px;
    font-family: var(--light);
    text-align: right;
  }

  .remover {
    font-size: 30px;
    font-family: var(--light);
    color: var(--cor-preto);

    text-align: center;
    text-decoration: none;
  }

  .info-total {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
  }

  .info-total .total {
    font-size: 25px;
    font-family: var(--light);


    width: 100%;
    margin-top: 50px;
    margin-bottom: 50px;
  }

  .info-total .butons {
    display: flex;
    gap: 20px;
  }

  .info-total .update {
      width: 300px;
      height: 50px;
      border-radius: 50px;

      background-color: var(--cor-branca);
      border: 2px solid var(--cor-verde-principal);
      font-family: var(--bold);
      font-size: 20px;
  }

  .info-total .checkout {
      width: 300px;
      height: 50px;
      border-radius: 50px;

      background-color: var(--cor-verde-principal);
      font-family: var(--bold);
      font-size: 20px;

  }

  </style>

  <script>
    document.querySelectorAll('.controle-qtd').forEach(controle => {
      const input = controle.querySelector('.qtd')
      const btnMais = controle.querySelector('.mais')
      const btnMenos = controle.querySelector('.menos')

      btnMais.addEventListener('click', () => {
        input.value = parseInt(input.value) + 1
      })

      btnMenos.addEventListener('click', () => {
        if (input.value > 1) {
          input.value = parseInt(input.value) - 1
        }
      })
    })

  </script>
