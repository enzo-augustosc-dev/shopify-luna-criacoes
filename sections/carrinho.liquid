<div id="carrinho" class="cart">

{% form 'cart', cart %}

<h1>Carrinho</h1>

  {%if cart.empty?%}
    <h2 class="vazio">Seu carrinho está vazio! Adicione alguns produtos e volte aqui!</h2>

    <a href="/" class="botao">Voltar a comprar!</a>
  {% endif %}
  {% for item in cart.items %}

    <div class="produto-cart">
      <div class="info-produto">
        <img class="imagem-produto" src="{{ item | image_url}}">
        <h2>{{ item.title }}</h2>
      </div>

    <input class="qtd" name="updates[]" type="text" value="{{ item.quantity }}">
    <p class="preco">{{ item.price | money }}</p>
    <a class="remover" href="{{ item.url_to_remove }}">X</a>
    <hr>

  </div>

   <p>Total do Carrinho: {{ cart.total_price | money}}</p>

    <button type="submit" name="update"> Atualizar Quantidade</button>

    <button type="submit" name="checkout">Comprar Agora!</button>
  {% endfor %}


{% endform %}
</div>

<style>

  .cart {
    display: flex;
    align-items: center;
    text-align: center;
    justify-content: center;

    padding: 0 80px;
    width: 100%;
    margin-top: 120px;
  }

  h1{
    font-size: 40px;
    font-family: var(--bold);
    margin-bottom: 10px;
  }

 .vazio {
    font-size: 20px;
    font-family: var(--light);
    margin-bottom: 60px;
  }

  .botao {
    color: var(--cor-preto);
    font-size: 20px;
    font-family: var(--bold);
    background-color: var(--cor-verde-principal-hover);

    padding: 15px;
    border-radius: 50px;
  }

  .botao:hover {
    font-size: 18px;
    background-color: var(--cor-verde-principal);

    transition: ease-in-out 0.2s;
  }

  .produto-cart {
  display: grid;
  grid-template-columns: 1fr 80px 120px 60px;
  align-items: center;
  gap: 20px;
  margin-bottom: 20px;

  border-bottom: 1px solid var(--cor-gelo);
  padding-bottom: 20px;
}

.info-produto {
  display: flex;
  align-items: center;
  gap: 15px;
}

.imagem-produto {
  width: 150px;
  height: 150px;
  object-fit: cover;
  border-radius: 40px;
}

.info-produto h2 {
  font-size: 30px;
  font-family: var(--bold);
  color: var(--cor-preto);
  margin: 0;
}

.qtd {
  font-size: 25px;
  font-family: var(--light);
  width: 20px;
  text-align: center;
}

.preco {
  font-size: 25px;
  font-family: var(--light);
  text-align: right;
}

.remover {
  font-size: 30px;
  font-family: var(--light);
  color: var(--cor-preto);

  text-align: center;
  text-decoration: none;
}

</style>
