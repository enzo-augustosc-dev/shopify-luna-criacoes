<section class="produtos-relacionados">
  {% assign current_collection = product.collections.first %}

  {% if current_collection %}

  <h2 class="titulo-produto">Produtos semelhantes</h2>

    {% for item in current_collection.products limit: 9 %}

      {% if item.id != product.id %}
          <a class="card-produto" href="{{ item.url }}">
            <img class="imagem-produto" src="{{ item.featured_image | image_url}}">
            <p class="nome-produto">{{ item.title }}</p>
            <span class="preco-produto">{{ item.price | money }}</span>
            <button>Compre Agora!</button>
          </a>
      {% endif %}

    {% endfor %}

</section>
{% endif %}

<style>
  .produtos-relacionados {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;

    padding: 0 80px;
    width: 100%;

    margin-top: 70px;
  }

  .titulo-produto {
    margin-bottom: 50px;
    width: 100%;

    font-family: var(--bold);
    font-size: 70px;
    text-align: center;

    background: linear-gradient(90deg, var(--cor-verde-principal), var(--cor-verde-principal-hover));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .titulo-produto::selection {
    background: rgba(0, 0, 0, 0.15);
    color: inherit;
  }

  .card-produto {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .card-produto .nome-produto {
    margin-top: 10px;

    font-size: 25px;
    font-family: var(--light);
    color: var(--cor-preto);
  }

  .card-produto .preco-produto {
    font-size: 20px;
    font-family: var(--bold);
    color: var(--cor-verde-principal);
  }

  .imagem-produto{
    width: 400px;
    height: 450px;
    border-radius: 50px;
  }

  .card-produto button {
    margin-top: 20px;

    width: 350px;
    height: 50px;
    border-radius: 50px;

    background-color: var(--cor-verde-principal);
    font-family: var(--bold);
    font-size: 20px;

    margin-bottom: 70px;
  }
</style>
