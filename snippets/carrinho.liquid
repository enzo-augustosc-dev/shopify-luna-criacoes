{% comment %} <div id="carrinho">

{% form 'cart', cart %}

<h1>Carrinho</h1>

  {%if cart.empty?%}
    <h1>Seu carrinho está vazio! Adicione alguns produtos e volte aqui!</h1>
  {% endif %}
  {% for item in cart.items %}

    <div>
      <img class="imagem-produto" src="{{ item | image_url}}">
      <h2>{{ item.title }}</h2>
      <p>{{ item.price | money }}</p>

      <input name="updates[]" value="{{ item.quantity }}">
      <a href="{{ item.url_to_remove }}">Remover Item</a>
    </div>

    <p>Total do Carrinho: {{ cart.total_price | money}}</p>

    <button type="submit" name="update"> Atualizar Quantidade</button>

    <button type="submit" name="checkout">Comprar Agora!</button>

  {% endfor %}


{% endform %}
</div>

<style>
   .imagem-produto{
    width: 400px;
    height: 450px;
    border-radius: 50px;
  }
</style> {% endcomment %}
